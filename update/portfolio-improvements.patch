+  { name: "CellposeSAM", role: "baseline · did not lead on recall or mIoU" },
+  { name: "Swin UNETR", role: "baseline · did not lead on recall or mIoU" },
+  { name: "nnU-Net", role: "baseline · did not lead on recall or mIoU" },
+  {
